{
  "name": "carbon-mcp",
  "version": "0.2.3",
  "description": "Taiwan Carbon Open Data (Unofficial): remote MCP server for Taiwan government emission factors and traceable emission calculations, on Cloudflare Workers. Not affiliated with any government agency.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "dry-run": "wrangler deploy --dry-run --outdir=dist",
    "db:local": "wrangler d1 migrations apply carbon-mcp --local",
    "db:remote": "wrangler d1 migrations apply carbon-mcp --remote",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "seed:local": "curl -s \"http://127.0.0.1:8787/__scheduled?cron=30+19+*+*+*\"",
    "check-concepts": "node scripts/check-concepts.mjs",
    "check-rate-limit": "node scripts/check-rate-limit.mjs",
    "make-og": "node scripts/make-og.mjs",
    "make-icons": "node scripts/make-icons.mjs",
    "check-registry": "node scripts/check-registry.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "0.33.0",
    "big.js": "7.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@types/big.js": "^7.0.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.161.0"
  },
  "engines": {
    "node": ">=24"
  }
}
